{
  "name": "pirate-islands-online",
  "main": "src/room.js",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "dev": { "ip": "0.0.0.0" }, // phones on the Wi-Fi reach the Mac's address (PIO3 01)
  "assets": { "directory": "public" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "LIMITER", "class_name": "Limiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Limiter"] }]
}
